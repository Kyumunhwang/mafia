{
  "name": "mafia-party-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mafia-server": "node server/server.js",
    "dev:mafia-client": "vite --port 3005 --strictPort --host",
    "dev:mafia-all": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:mafia-server\" \"npm run dev:mafia-client\"",
    "build:mafia": "vite build",
    "preview:mafia": "vite preview --port 3005"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
